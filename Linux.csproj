<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>CncTrainer</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- The editor addon reads this file to show the /// summaries in the
         inspector; Godot itself does not take descriptions from C#. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573;CS1572;CS1574;CS1584;CS1658;CS1570;CS1587</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Godot.NET.Sdk globs all *.cs recursively by default, which would also
         pull in Tests/*.cs (an independent xunit project one level down) and
         fail to compile it here for lack of the xunit package reference. -->
    <Compile Remove="Tests/**/*.cs" />
  </ItemGroup>
</Project>
