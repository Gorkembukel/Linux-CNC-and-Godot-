G0 Z10.0
G0 X-40.0 Y-35.0

#1 = -3.0
o100 while [#1 GE -9.0]
  G1 Z#1 F150
  G1 X40.0 F450
  G3 X55.0 Y-20.0 I0.0 J15.0
  G1 Y20.0
  G3 X40.0 Y35.0 I-15.0 J0.0
